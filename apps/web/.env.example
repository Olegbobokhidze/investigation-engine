# Copy to .env.local and adjust. Values here are public: Vite inlines them into the bundle.
VITE_API_BASE_URL=http://localhost:8000

# Which API calls the browser answers with mock data (Mock Service Worker):
#   enabled         everything — the UI runs without the backend
#   investigations  only POST /investigations; documents use the real backend
#   disabled        nothing — the real backend for everything
VITE_API_MOCKING=enabled
