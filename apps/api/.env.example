# Copy to .env and fill in. Never commit .env.
# Defaults point at the local services from docker-compose.yml.
ENV=dev
LOG_LEVEL=INFO

# Neon: Project → Connect → turn off connection pooling → copy the connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/investigation_engine

# Qdrant Cloud: Cluster → URL, and API Keys → Create. Leave the key empty for local Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Groq: console.groq.com → API Keys → Create.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
