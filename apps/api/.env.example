# Copy to .env and fill in. Never commit .env.
# Defaults point at the local services from docker-compose.yml.
ENV=dev
LOG_LEVEL=INFO

# Browser origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Neon: Project → Connect → turn off connection pooling → copy the connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/investigation_engine

# Qdrant Cloud: Cluster → URL, and API Keys → Create. Leave the key empty for local Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Groq: console.groq.com → API Keys → Create.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# One more search and LLM call per answer, to catch sources that disagree with it.
AGENT_CROSS_CHECK=false

# Daily investigation caps (UTC days), per client IP and in total.
INVESTIGATIONS_PER_CLIENT_PER_DAY=20
INVESTIGATIONS_PER_DAY=40
# Answer cache: entries and their lifetime in seconds; 0 entries turns it off.
ANSWER_CACHE_SIZE=500
ANSWER_CACHE_TTL_S=86400

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
